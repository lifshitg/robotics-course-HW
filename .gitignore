# Local instructor solutions. Keep this rule before creating solution files.
/assignments/*/ta_solution/

# Generated assignment PDFs and other document build output.
/build/

# ROS workspace output.
/assignments/*/environment/build/
/assignments/*/environment/install/
/assignments/*/environment/log/
/assignments/*/my_solution/build/
/assignments/*/my_solution/install/
/assignments/*/my_solution/log/

# Local Python environments and caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
