<?xml version="1.0"?>
<robot name="hw01_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controllers" default="$(find hw01_sim)/config/controllers.yaml"/>
  <material name="blue"><color rgba="0.15 0.35 0.9 1"/></material>
  <material name="yellow"><color rgba="0.95 0.7 0.1 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <link name="world"/>
  <link name="base_link">
    <inertial><origin xyz="0 0 0.09"/><mass value="5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
    <visual><origin xyz="0 0 0.09"/><geometry><cylinder radius="0.04" length="0.18"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.09"/><geometry><cylinder radius="0.04" length="0.18"/></geometry></collision>
  </link>
  <joint name="world_to_base" type="fixed"><parent link="world"/><child link="base_link"/></joint>
  <link name="link1">
    <inertial><origin xyz="0.15 0 0"/><mass value="0.5"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0038" iyz="0" izz="0.0038"/>
    </inertial>
    <visual><origin xyz="0.15 0 0"/><geometry><box size="0.30 0.035 0.03"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0.15 0 0"/><geometry><box size="0.30 0.035 0.03"/></geometry></collision>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.18"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159265359" upper="3.14159265359" effort="20" velocity="3"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <link name="link2">
    <inertial><origin xyz="0.125 0 0"/><mass value="0.4"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0022"/>
    </inertial>
    <visual><origin xyz="0.125 0 0"/><geometry><box size="0.25 0.035 0.03"/></geometry><material name="yellow"/></visual>
    <collision><origin xyz="0.125 0 0"/><geometry><box size="0.25 0.035 0.03"/></geometry></collision>
    <visual><origin xyz="0.25 0 -0.04"/><geometry><cylinder radius="0.006" length="0.08"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0.25 0 -0.04"/><geometry><cylinder radius="0.006" length="0.08"/></geometry></collision>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="link1"/><child link="link2"/><origin xyz="0.30 0 0.04"/><axis xyz="0 0 1"/>
    <limit lower="0.1" upper="3.04159265359" effort="20" velocity="3"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <link name="tool0"/>
  <joint name="tool_fixed" type="fixed"><parent link="link2"/><child link="tool0"/><origin xyz="0.25 0 -0.08"/></joint>
  <ros2_control name="HW1Arm" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">2.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers)</parameters>
    </plugin>
  </gazebo>
</robot>
